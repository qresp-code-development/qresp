# Dev image: same Python baseline as the production Dockerfile (python:3.14),
# but installs from requirements.txt (floating) instead of the lock; source is
# bind-mounted by docker-compose.dev.yml and served by uvicorn --reload.
# (Was python:3.6-alpine, EOL, plus an apk build toolchain that Debian-slim's
# manylinux wheels make unnecessary.)
FROM python:3.11-slim

# Dump logs without buffering
ENV PYTHONUNBUFFERED=1

WORKDIR /home/flask/app/web

# Install the package dependencies
COPY requirements.txt /home/flask/app/web/
RUN pip install --no-cache-dir --progress-bar off -r requirements.txt

# Copy the source code into the container (dev compose bind-mounts over it)
COPY . /home/flask/app/web
