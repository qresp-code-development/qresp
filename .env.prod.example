# Production environment for docker-compose.yml (paperstack.uchicago.edu).
# Copy to .env.prod and fill in real values. .env.prod is gitignored — never
# commit actual secrets.
#
# NEVER set these in production: QRESP_ENABLE_DEV_LOGIN,
# QRESP_PUBLISH_SKIP_EMAIL, QRESP_OAUTHLIB_INSECURE_TRANSPORT.

# Public origin of this site, used in emailed links (account confirmation).
# Required for email/password sign-up; never derived from request headers.
QRESP_PUBLIC_URL=https://paperstack.uchicago.edu

# Flask session signing key — long random string, e.g. `openssl rand -hex 32`
QRESP_FLASK_SECRET_KEY=

# Google OAuth — the redirect URI must be an authorized redirect URI on the
# Google Cloud OAuth client.
QRESP_GOOGLE_CLIENT_ID=
QRESP_GOOGLE_CLIENT_SECRET=
QRESP_GOOGLE_REDIRECT_URI=https://paperstack.uchicago.edu/api/auth/google/callback

# Microsoft Entra (optional; leave blank until the app registration exists)
# QRESP_MICROSOFT_CLIENT_ID=
# QRESP_MICROSOFT_CLIENT_SECRET=
# QRESP_MICROSOFT_REDIRECT_URI=https://paperstack.uchicago.edu/api/auth/microsoft/callback

# GitHub OAuth (optional; github.com/settings/developers → OAuth Apps)
# QRESP_GITHUB_CLIENT_ID=
# QRESP_GITHUB_CLIENT_SECRET=
# QRESP_GITHUB_REDIRECT_URI=https://paperstack.uchicago.edu/api/auth/github/callback

# Outgoing mail (publish verification emails)
QRESP_FROM_ADDR=
QRESP_MAIL_PWD=
QRESP_SMTP_SERVER=smtp.gmail.com
QRESP_SMTP_PORT=587

# Comma-separated admin email allowlist
QRESP_ADMIN_EMAILS=

# RCC file server
QRESP_FILESERVER_ROOTS=https://notebook.rcc.uchicago.edu/files
QRESP_FILESERVER_INSECURE_TLS_HOSTS=notebook.rcc.uchicago.edu

# Gemini AI features (optional)
# QRESP_GEMINI_API_KEY=
