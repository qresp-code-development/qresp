# Copy this file to .env.dev and fill in real values.
# .env.dev is gitignored — never commit actual secrets.
#
# Flask session signing key (any long random string for local dev)
QRESP_FLASK_SECRET_KEY=change-this-to-a-random-secret

# Google OAuth credentials — from Google Cloud Console.
# Authorized redirect URI must include: https://localhost:8444/api/auth/google/callback
QRESP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
QRESP_GOOGLE_CLIENT_SECRET=your-client-secret
QRESP_GOOGLE_REDIRECT_URI=https://localhost:8444/api/auth/google/callback

# GitHub OAuth credentials — from github.com/settings/developers → OAuth Apps.
# Authorization callback URL: https://localhost:8444/api/auth/github/callback
QRESP_GITHUB_CLIENT_ID=your-github-client-id
QRESP_GITHUB_CLIENT_SECRET=your-github-client-secret
QRESP_GITHUB_REDIRECT_URI=https://localhost:8444/api/auth/github/callback
